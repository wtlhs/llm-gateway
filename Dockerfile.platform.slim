# llm-platform 服务器瘦镜像(与 Dockerfile.slim 同模式)
# 前端已 embed 进二进制, 无需 node 构建阶段; 绕过服务器 go mod download 网络问题
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
COPY platform-linux /usr/local/bin/platform
RUN chmod +x /usr/local/bin/platform
USER app
WORKDIR /app
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/platform"]
