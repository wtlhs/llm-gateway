# llm-gateway 服务器部署配置模板
# 复制为 .env.deploy 并填入真实值(.env.deploy 已被 .gitignore, 不入库)
# 容器在 1panel-network，用容器名互联

# ===== 监听与上游 =====
LISTEN_ADDR=:8080
# New API 容器名:内部端口（同在 1panel-network）
NEW_API_BASE_URL=http://<newapi-container>:3000
NEW_API_TLS=false

# ===== 双库 =====
# 读写库：审计数据沉淀（PG llm_gateway 库，用容器名）
CONTEXT_DB_URL=postgres://<user>:<password>@<pg-container>:5432/llm_gateway?sslmode=disable
# 只读库：反查 New API token 映射（MySQL，与 New API 容器的 SQL_DSN 一致）
NEWAPI_DB_URL=<user>:<password>@tcp(<mysql-container>:3306)/new_api?charset=utf8mb4&parseTime=true&loc=Local

# ===== 审计 =====
LLM_AUDIT_MODE=redact
LLM_AUDIT_EXCLUDE_MODELS=
LLM_AUDIT_CAPTURE_ENDPOINTS=chat/completions,completions,responses,embeddings,moderations
LLM_AUDIT_MAX_BODY_BYTES=65536
LLM_AUDIT_PRE_BODY_MAX_BYTES=33554432
LLM_AUDIT_TTL_DAYS=90

# ===== 过载保护 =====
BREAKER_FAILURES=5
RATE_PER_CALLER=50
RATE_BURST=100
RATE_ANON=10

# ===== 性能 =====
CAPTURE_CHANNEL_SIZE=4096
DB_MAX_OPEN_CONNS=25
WORKER_POOL_SIZE=8
SHUTDOWN_TIMEOUT_SEC=30s
DRAIN_TIMEOUT_SEC=20s

# ===== caller 反查 =====
CALLER_CACHE_REFRESH_SEC=60s

# ===== 安全 =====
# 管理端点 bearer，部署后用这个 token 访问 /ctx/* 和 /metrics
METRICS_AUTH_TOKEN=
ADMIN_AUTH_TOKEN=
SLOG_PROMPT_FIELDS_BLOCKLIST=request.body,response.body,prompt_text,completion_text

# ===== 日志 =====
LOG_LEVEL=info
